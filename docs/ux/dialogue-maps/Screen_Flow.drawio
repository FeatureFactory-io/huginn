        <!-- ════════ LEGEND ════════ -->
        <mxCell id="leg2" value="&lt;b&gt;Screen Box Legend&lt;/b&gt;&lt;br&gt;Bold border (strokeWidth=3) = LIST+FIND entry-point&lt;br&gt;Solid thin border = regular screen&lt;br&gt;Dashed border = modal / confirmation&lt;br&gt;─── solid arrow = primary navigation&lt;br&gt;- - - dashed arrow = secondary / optional flow&lt;br&gt;Green arrow = success path&lt;br&gt;Gold dashed = Decision branch outcome" style="text;html=1;strokeColor=#cccccc;fillColor=#f9f9f9;align=left;verticalAlign=top;spacingLeft=6;rounded=1;fontSize=9;" vertex="1" parent="1">
