        <mxCell id="cl13" value="+ FRAGO from breach" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;dashed=1;strokeColor=#d6b656;" edge="1" source="s_sr_view" target="s_fg_list" parent="1">
          <mxGeometry relative="1" as="geometry"/>
