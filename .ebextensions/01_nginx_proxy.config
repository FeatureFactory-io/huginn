# EB writes the nginx upstream using the container's internal Docker IP
# (from docker inspect), which changes with every deployment.
# This post-deploy hook overwrites the upstream with the stable host port
# (8080 → gunicorn:8000 via Docker's host port mapping) and reloads nginx.

files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_fix_nginx.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail
      # Replace whatever IP:port EB wrote with the stable host port mapping
      CONF=$(ls /etc/nginx/conf.d/*.conf 2>/dev/null | head -1)
      if [ -n "$CONF" ]; then
        sed -i 's|server [0-9\.]*:[0-9]*;|server 127.0.0.1:8080;|g' "$CONF"
        nginx -t && systemctl reload nginx
        echo "nginx upstream fixed → 127.0.0.1:8080"
      fi
