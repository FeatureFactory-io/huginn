# EB generates /etc/nginx/conf.d/elasticbeanstalk-nginx-docker-upstream.conf
# with the container's compose-network IP (e.g. 172.23.0.3:8000), which is NOT
# routable from the EB host. We must redirect nginx to the stable host port
# 127.0.0.1:8080 (docker-proxy that always maps to gunicorn:8000 inside the
# container).
#
# The appdeploy/post hook runs *before* EB writes the nginx config, so we use
# a systemd oneshot service triggered by nginx.service instead.

files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_fix_nginx.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Patch EB's generated nginx upstream to the stable host-port mapping.
      CONF=/etc/nginx/conf.d/elasticbeanstalk-nginx-docker-upstream.conf
      if [ -f "$CONF" ]; then
        sed -i 's|server [0-9\.]*:[0-9]*;|server 127.0.0.1:8080;|g' "$CONF"
        # reload fails silently when nginx is inactive (preset: disabled on AL2023).
        if nginx -t 2>/dev/null; then
          systemctl enable nginx 2>/dev/null || true
          systemctl restart nginx
        fi
        echo "nginx patched → 127.0.0.1:8080"
      fi

  "/etc/systemd/system/nginx-eb-proxy-fix.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Patch EB nginx upstream to use host port 8080
      After=nginx.service
      BindsTo=nginx.service

      [Service]
      Type=oneshot
      ExecStartPre=/bin/sleep 5
      ExecStart=/opt/elasticbeanstalk/hooks/appdeploy/post/99_fix_nginx.sh
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target

commands:
  01_enable_nginx_fix:
    command: "systemctl daemon-reload && systemctl enable nginx-eb-proxy-fix.service || true"
  02_enable_nginx_service:
    command: "systemctl enable nginx || true"
